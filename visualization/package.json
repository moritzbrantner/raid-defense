{
  "name": "raid-defense-visualization",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../v2/crates/raid-defense-wasm --release --target web --out-dir ../../../visualization/src/generated/raid-defense-wasm --out-name raid_defense_wasm",
    "build:wasm:dev": "wasm-pack build ../v2/crates/raid-defense-wasm --dev --target web --out-dir ../../../visualization/src/generated/raid-defense-wasm --out-name raid_defense_wasm",
    "predev": "bun run build:wasm:dev",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "bun run build:wasm && bun run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint@1.80.0 src e2e --format=github",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
