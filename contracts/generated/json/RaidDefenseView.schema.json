{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RaidDefenseView",
  "type": "object",
  "required": [
    "alerts",
    "areas",
    "available_tech_nodes",
    "buildings",
    "encountered_attack_waves",
    "encountered_units",
    "entities",
    "food_logistics",
    "jobs",
    "now_seconds",
    "objectives",
    "paths",
    "resources",
    "summary",
    "tech_nodes",
    "upgrades"
  ],
  "properties": {
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AlertView"
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AreaView"
      }
    },
    "available_tech_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/BuildingView"
      }
    },
    "encountered_attack_waves": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AttackWaveView"
      }
    },
    "encountered_units": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EncounteredUnitView"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EntityView"
      }
    },
    "food_logistics": {
      "$ref": "#/definitions/FoodLogisticsView"
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/JobView"
      }
    },
    "now_seconds": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ObjectiveView"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PathView"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ResourceView"
      }
    },
    "summary": {
      "$ref": "#/definitions/RaidDefenseSummary"
    },
    "tech_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "upgrades": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "AlertView": {
      "type": "object",
      "required": [
        "message",
        "severity"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      }
    },
    "AreaView": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "tiles"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MapLocation"
          }
        }
      }
    },
    "AttackWaveUnitView": {
      "type": "object",
      "required": [
        "count",
        "kind",
        "label"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "AttackWaveView": {
      "type": "object",
      "required": [
        "encountered_at_seconds",
        "entry",
        "id",
        "label",
        "units"
      ],
      "properties": {
        "encountered_at_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "entry": {
          "$ref": "#/definitions/MapLocation"
        },
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "label": {
          "type": "string"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttackWaveUnitView"
          }
        }
      }
    },
    "BuildingFootprint": {
      "type": "object",
      "required": [
        "depth",
        "width"
      ],
      "properties": {
        "depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "BuildingLogisticsView": {
      "type": "object",
      "required": [
        "active_routes",
        "blocked",
        "role",
        "route_slots",
        "spoiling"
      ],
      "properties": {
        "active_routes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "blocked": {
          "type": "boolean"
        },
        "connected_storage_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "role": {
          "type": "string"
        },
        "route_slots": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "service_radius": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "spoiling": {
          "type": "boolean"
        }
      }
    },
    "BuildingView": {
      "type": "object",
      "required": [
        "assigned_workers",
        "footprint",
        "height",
        "id",
        "inventory",
        "kind",
        "label",
        "level",
        "location",
        "manned",
        "production",
        "required_workers",
        "stats",
        "status"
      ],
      "properties": {
        "assigned_workers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "footprint": {
          "$ref": "#/definitions/BuildingFootprint"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceView"
          }
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "location": {
          "$ref": "#/definitions/MapLocation"
        },
        "logistics": {
          "anyOf": [
            {
              "$ref": "#/definitions/BuildingLogisticsView"
            },
            {
              "type": "null"
            }
          ]
        },
        "manned": {
          "type": "boolean"
        },
        "production": {
          "type": "string"
        },
        "required_workers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "stats": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int64"
          }
        },
        "status": {
          "type": "string"
        }
      }
    },
    "EncounteredUnitView": {
      "type": "object",
      "required": [
        "current_count",
        "encountered_at_seconds",
        "kind",
        "label"
      ],
      "properties": {
        "current_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "encountered_at_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "EntityBlueprintRef": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Unit"
          ],
          "properties": {
            "Unit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Npc"
          ],
          "properties": {
            "Npc": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "EntityView": {
      "type": "object",
      "required": [
        "blueprint",
        "id",
        "kind",
        "label",
        "location",
        "stats"
      ],
      "properties": {
        "assigned_building": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "assigned_job": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "blueprint": {
          "$ref": "#/definitions/EntityBlueprintRef"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/MapLocation"
        },
        "stats": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "FoodLogisticsView": {
      "type": "object",
      "required": [
        "blocked_farms",
        "delivered_last_minute",
        "reserve_state",
        "spoiled_last_minute",
        "strained_storage"
      ],
      "properties": {
        "blocked_farms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "delivered_last_minute": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "reserve_state": {
          "type": "string"
        },
        "spoiled_last_minute": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "strained_storage": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "JobView": {
      "type": "object",
      "required": [
        "assigned_entities",
        "completes_at_seconds",
        "id",
        "kind"
      ],
      "properties": {
        "assigned_entities": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        },
        "completes_at_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "MapLocation": {
      "type": "object",
      "required": [
        "elevation",
        "x",
        "y"
      ],
      "properties": {
        "elevation": {
          "type": "integer",
          "format": "int32"
        },
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "ObjectiveView": {
      "type": "object",
      "required": [
        "complete",
        "current",
        "id",
        "label",
        "target"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "current": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "PathView": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "waypoints"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MapLocation"
          }
        }
      }
    },
    "RaidDefenseSummary": {
      "type": "object",
      "required": [
        "active_legions",
        "average_control",
        "average_loyalty",
        "critical",
        "influence_rank",
        "lost",
        "province_count",
        "tax_rate",
        "total_threat",
        "won"
      ],
      "properties": {
        "active_legions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "average_control": {
          "type": "integer",
          "format": "int64"
        },
        "average_loyalty": {
          "type": "integer",
          "format": "int64"
        },
        "critical": {
          "type": "boolean"
        },
        "influence_rank": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "lost": {
          "type": "boolean"
        },
        "province_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "tax_rate": {
          "type": "integer",
          "format": "int64"
        },
        "total_threat": {
          "type": "integer",
          "format": "int64"
        },
        "won": {
          "type": "boolean"
        }
      }
    },
    "ResourceView": {
      "type": "object",
      "required": [
        "amount",
        "id",
        "label"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    }
  }
}